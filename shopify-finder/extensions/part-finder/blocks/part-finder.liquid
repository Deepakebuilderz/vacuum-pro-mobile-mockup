<div id="vacuum-finder-{{ block.id }}" class="vpf" data-vpf data-suggestions="{{ block.settings.show_suggestions }}" data-suggestion-count="{{ block.settings.suggestion_count }}" data-found-label="{{ block.settings.found_label | escape }}" data-not-found-label="{{ block.settings.not_found_label | escape }}" data-section="{{ section.id }}" data-ocr="{{ 'ocr.js' | asset_url }}" data-worker="{{ 'worker.min.js' | asset_url }}" style="--vpf-accent:{{ block.settings.accent }}" {{ block.shopify_attributes }}>
  <div class="vpf-heading"><span class="vpf-eyebrow">VACUUM PRO / PART FINDER</span><h2>{{ block.settings.heading | escape }}</h2><p>Enter your model or part number, or take a photo of the label.</p></div>
  <div class="vpf-controls">
    <form data-form><label for="number-{{ block.id }}">Model or part number</label><input id="number-{{ block.id }}" data-number type="search" placeholder="e.g. FH51000 or 440005536" maxlength="80" autocomplete="off" enterkeyhint="search" required><button type="submit">Search parts <span aria-hidden="true">→</span></button></form>
    <div class="vpf-or"><span>or use a photo</span></div>
    <div class="vpf-photo-controls"><button data-camera {% unless block.settings.enable_camera %}hidden{% endunless %} class="vpf-camera" type="button"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h5l2-3h4l2 3h5v13H3z"/><circle cx="12" cy="13" r="3.5"/></svg><span><strong>Scan with camera</strong><small>Photograph the printed number</small></span><span aria-hidden="true">↗</span></button><button data-gallery {% unless block.settings.enable_gallery %}hidden{% endunless %} class="vpf-gallery" type="button">or upload from gallery</button><input data-camera-file type="file" accept="image/*" capture="environment" aria-label="Take a label photo" hidden><input data-gallery-file type="file" accept="image/*" aria-label="Upload a label photo" hidden><small class="vpf-privacy">Label text is read in your browser. Your photo is not uploaded.</small></div>
  </div>
  <p data-status class="vpf-status" role="status" aria-live="polite" hidden></p>
  <div data-photo class="vpf-photo" hidden><img data-preview alt="Selected label photo" width="64" height="64"><div><strong>Check the detected number</strong><p>Correct it above if needed.</p><label data-candidate-label hidden>Other detected numbers<select data-candidates aria-label="Other detected numbers"></select></label></div></div>
  <details class="vpf-help"><summary><span>Where’s my model number?<small>A quick guide to finding your label</small></span><span class="vpf-chevron" aria-hidden="true">⌄</span></summary><div><p>Look under the vacuum base, near the power cord, or on the back. For a part number, check the old part.</p><p><strong>Photo tip:</strong> Move close, keep the full number in frame and avoid glare.</p></div></details>
  <section data-results class="vpf-results" aria-label="Finder results" aria-live="polite" hidden></section>
  {% if block.settings.help_url != blank %}<a class="vpf-support" href="{{ block.settings.help_url | escape }}">Need help choosing the right part? →</a>{% endif %}
  {% assign finder_collection = block.settings.collection | default: collections.all %}
  {% paginate finder_collection.products by 100 %}
    {% capture catalog_json %}
    {"next":{{ paginate.next.url | json }},"products":[{% for item in finder_collection.products %}{% unless forloop.first %},{% endunless %}{"id":{{ item.id | append: '' | json }},"title":{{ item.title | json }},"vendor":{{ item.vendor | json }},"productType":{{ item.type | json }},"description":{{ item.description | strip_html | json }},"tags":{{ item.tags | json }},"mpn":{"value":{{ item.metafields.custom.mpn.value | json }}},"compatibleModels":{"type":"list.single_line_text_field","value":{% capture models_json %}[{% for model in item.metafields.custom.compatible_models.value %}{% unless forloop.first %},{% endunless %}{% if model.model_number != blank %}{{ model.model_number.value | json }}{% else %}{{ model | json }}{% endif %}{% endfor %}]{% endcapture %}{{ models_json | json }}},"variants":{"nodes":[{"sku":{{ item.selected_or_first_available_variant.sku | json }}}]},"url":{{ item.url | json }},"image":{% if item.featured_image %}{{ item.featured_image | image_url: width: 480 | json }}{% else %}null{% endif %},"price":{{ item.price | money_with_currency | strip_html | json }},"available":{{ item.available | json }}}{% endfor %}]}
    {% endcapture %}
    <script type="application/json" data-catalog>{{ catalog_json | replace: '<', '\u003c' }}</script>
  {% endpaginate %}
</div>
{% schema %}
{
  "name":"Vacuum PRO Part Finder",
  "target":"section",
  "stylesheet":"finder.css",
  "javascript":"finder.js",
  "settings":[
    {"type":"text","id":"heading","label":"Heading","default":"Find your part"},
    {"type":"collection","id":"collection","label":"Finder product collection","info":"Choose a collection containing all parts to search. If empty, the store all-products collection is used."},
    {"type":"color","id":"accent","label":"Button color","default":"#1c3158"},
    {"type":"checkbox","id":"enable_camera","label":"Enable camera scanning","default":true},
    {"type":"checkbox","id":"enable_gallery","label":"Enable gallery upload","default":true},
    {"type":"checkbox","id":"show_suggestions","label":"Show suggested parts after search","default":true},
    {"type":"range","id":"suggestion_count","label":"Suggested parts count","min":1,"max":8,"step":1,"default":4},
    {"type":"text","id":"found_label","label":"Product found heading","default":"Product found"},
    {"type":"text","id":"not_found_label","label":"Product not found heading","default":"Product not found"},
    {"type":"url","id":"help_url","label":"Fitment help page"}
  ]
}
{% endschema %}
