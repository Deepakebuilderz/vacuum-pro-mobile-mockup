{% assign finder_url = routes.root_url | append: 'pages/part-finder' %}
{% if block.settings.finder_page != blank %}{% assign finder_url = block.settings.finder_page.url %}{% endif %}
<section class="vpf-entry-banner" style="--vpf-entry-accent:{{ block.settings.accent }}" {{ block.shopify_attributes }}>
  <span class="vpf-entry-mark" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5M8 10.5h5M10.5 8v5"/></svg></span>
  <div><span class="vpf-entry-eyebrow">PART FINDER</span><h2>{{ block.settings.heading | escape }}</h2><p>{{ block.settings.description | escape }}</p></div>
  <a href="{{ finder_url | escape }}">{{ block.settings.button_text | escape }} <span aria-hidden="true">→</span></a>
</section>
{% schema %}
{"name":"Finder homepage banner","target":"section","stylesheet":"finder.css","settings":[{"type":"page","id":"finder_page","label":"Finder page"},{"type":"text","id":"heading","label":"Heading","default":"Not sure which part fits?"},{"type":"text","id":"description","label":"Description","default":"Search by model or part number, or scan your label."},{"type":"text","id":"button_text","label":"Button label","default":"Find your part"},{"type":"color","id":"accent","label":"Accent color","default":"#1c3158"}]}
{% endschema %}
